# E-commerce Application Environment Configuration
# Copy this file to .env and modify as needed

# Application Environment
NODE_ENV=development
PORT=5000

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/ecommerce
# For Docker: mongodb://admin:password123@mongodb:27017/ecommerce?authSource=admin

# JWT Configuration
JWT_SECRET=your-jwt-secret-key-here
JWT_EXPIRES_IN=24h

# Session Configuration
SESSION_SECRET=your-session-secret-key-here

# File Upload Configuration
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=10485760

# Admin Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=secure-admin-password

# Database Credentials
DB_USERNAME=ecommerce_user
DB_PASSWORD=secure-database-password

# Redis Configuration (for session storage)
REDIS_URL=redis://localhost:6379
# For Docker: redis://redis:6379

# Email Configuration (for password reset)
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=noreply@ecommerce.com
EMAIL_PASS=secure-email-password

# API Keys
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_secret

# Security Configuration
BCRYPT_ROUNDS=12
RATE_LIMIT_ENABLED=true
CORS_ORIGIN=http://localhost:3000
HELMET_ENABLED=true

# SSL Configuration
SSL_CERT_PATH=./ssl/server.crt
SSL_KEY_PATH=./ssl/server.key
SSL_VERIFY=true

# Logging Configuration
LOG_LEVEL=info
LOG_FILE=./logs/app.log
LOG_SENSITIVE_DATA=false